{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomay.example/contracts/guest-mvp/v1",
  "title": "Roomay Guest MVP Provider-Neutral Contract",
  "description": "Wire-level contract only. Authentication, Workpeg calls, persistence and delivery are implemented by separately verified adapters.",
  "type": "object",
  "required": [
    "contract_version",
    "message_type",
    "correlation_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "roomay.guest-mvp.v1"
    },
    "message_type": {
      "enum": [
        "guest_context",
        "hotel_information",
        "conversation_action",
        "request_draft",
        "request_outcome",
        "reception_transition",
        "guest_status_readback"
      ]
    },
    "correlation_id": {
      "$ref": "#/$defs/id"
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "failure_code": {
      "type": "string",
      "enum": [
        "unauthenticated",
        "membership_unverified",
        "wrong_business",
        "wrong_hotel",
        "wrong_room",
        "stay_revoked",
        "stay_expired",
        "stay_not_active",
        "duplicate_operation",
        "idempotency_conflict",
        "workpeg_unavailable",
        "persistence_uncertain",
        "not_found",
        "forbidden",
        "invalid_contract",
        "stale_version"
      ]
    },
    "failure": {
      "type": "object",
      "required": [
        "code",
        "retryable"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/failure_code"
        },
        "retryable": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "guest_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "stay",
        "authorized_hotel",
        "authorized_room"
      ],
      "properties": {
        "state": {
          "enum": [
            "verified",
            "unauthenticated",
            "revoked",
            "expired",
            "unavailable"
          ]
        },
        "stay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verified",
            "status",
            "room_id",
            "valid_until"
          ],
          "properties": {
            "verified": {
              "const": true
            },
            "status": {
              "const": "checked_in"
            },
            "room_id": {
              "$ref": "#/$defs/id"
            },
            "valid_until": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "authorized_hotel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display_name"
          ],
          "properties": {
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "approved_information": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/approved_information"
              }
            }
          }
        },
        "authorized_room": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display_label"
          ],
          "properties": {
            "display_label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "approved_information": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/approved_information"
              }
            }
          }
        },
        "failure": {
          "$ref": "#/$defs/failure"
        }
      }
    },
    "approved_information": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "value"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "value": {
          "type": "string",
          "maxLength": 1200
        }
      }
    },
    "hotel_information": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "answer_state"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "answer_state": {
          "enum": [
            "answered",
            "unavailable",
            "handoff"
          ]
        },
        "answer": {
          "type": "string",
          "maxLength": 1200
        },
        "failure": {
          "$ref": "#/$defs/failure"
        }
      }
    },
    "conversation_action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "message",
            "confirm",
            "cancel"
          ]
        },
        "interaction_id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "confirmation_handle": {
          "$ref": "#/$defs/id"
        }
      },
      "oneOf": [
        {
          "title": "guest message",
          "required": [
            "operation",
            "interaction_id",
            "text"
          ],
          "properties": {
            "operation": {
              "const": "message"
            }
          }
        },
        {
          "title": "explicit confirmation",
          "required": [
            "operation",
            "interaction_id",
            "confirmation_handle"
          ],
          "properties": {
            "operation": {
              "const": "confirm"
            }
          }
        },
        {
          "title": "explicit cancellation",
          "required": [
            "operation",
            "interaction_id",
            "confirmation_handle"
          ],
          "properties": {
            "operation": {
              "const": "cancel"
            }
          }
        }
      ]
    },
    "request_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_id",
        "description",
        "category",
        "department",
        "confirmation_required",
        "confirmation_handle"
      ],
      "properties": {
        "draft_id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "department": {
          "enum": [
            "reception",
            "housekeeping",
            "maintenance",
            "food_and_beverage"
          ]
        },
        "confirmation_required": {
          "const": true
        },
        "confirmation_handle": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "request_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "persisted"
      ],
      "properties": {
        "state": {
          "enum": [
            "created",
            "duplicate",
            "rejected",
            "unavailable",
            "uncertain"
          ]
        },
        "persisted": {
          "type": "boolean"
        },
        "request_reference": {
          "$ref": "#/$defs/id"
        },
        "audit_reference": {
          "$ref": "#/$defs/id"
        },
        "failure": {
          "$ref": "#/$defs/failure"
        }
      }
    },
    "reception_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_reference",
        "operation_id",
        "expected_version",
        "action"
      ],
      "properties": {
        "request_reference": {
          "$ref": "#/$defs/id"
        },
        "operation_id": {
          "$ref": "#/$defs/id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "assign",
            "acknowledge",
            "start_work",
            "resolve",
            "reopen",
            "cancel",
            "escalate"
          ]
        },
        "target_status": {
          "enum": [
            "assigned",
            "acknowledged",
            "in_progress",
            "resolved",
            "reopened",
            "cancelled",
            "escalated"
          ]
        },
        "assignee_reference": {
          "$ref": "#/$defs/id"
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "guest_status_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_reference",
        "status",
        "updated_at"
      ],
      "properties": {
        "request_reference": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "received",
            "assigned",
            "acknowledged",
            "in_progress",
            "resolved",
            "reopened",
            "cancelled",
            "escalated"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "guest_message": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "envelope_guest_context": {
      "type": "object",
      "required": [
        "contract_version",
        "message_type",
        "correlation_id",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "roomay.guest-mvp.v1"
        },
        "message_type": {
          "const": "guest_context"
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "payload": {
          "$ref": "#/$defs/guest_context"
        }
      }
    },
    "envelope_hotel_information": {
      "type": "object",
      "required": [
        "contract_version",
        "message_type",
        "correlation_id",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "roomay.guest-mvp.v1"
        },
        "message_type": {
          "const": "hotel_information"
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "payload": {
          "$ref": "#/$defs/hotel_information"
        }
      }
    },
    "envelope_conversation_action": {
      "type": "object",
      "required": [
        "contract_version",
        "message_type",
        "correlation_id",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "roomay.guest-mvp.v1"
        },
        "message_type": {
          "const": "conversation_action"
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "payload": {
          "$ref": "#/$defs/conversation_action"
        }
      }
    },
    "envelope_request_draft": {
      "type": "object",
      "required": [
        "contract_version",
        "message_type",
        "correlation_id",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "roomay.guest-mvp.v1"
        },
        "message_type": {
          "const": "request_draft"
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "payload": {
          "$ref": "#/$defs/request_draft"
        }
      }
    },
    "envelope_request_outcome": {
      "type": "object",
      "required": [
        "contract_version",
        "message_type",
        "correlation_id",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "roomay.guest-mvp.v1"
        },
        "message_type": {
          "const": "request_outcome"
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "payload": {
          "$ref": "#/$defs/request_outcome"
        }
      }
    },
    "envelope_reception_transition": {
      "type": "object",
      "required": [
        "contract_version",
        "message_type",
        "correlation_id",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "roomay.guest-mvp.v1"
        },
        "message_type": {
          "const": "reception_transition"
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "payload": {
          "$ref": "#/$defs/reception_transition"
        }
      }
    },
    "envelope_guest_status_readback": {
      "type": "object",
      "required": [
        "contract_version",
        "message_type",
        "correlation_id",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "roomay.guest-mvp.v1"
        },
        "message_type": {
          "const": "guest_status_readback"
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "payload": {
          "$ref": "#/$defs/guest_status_readback"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/envelope_guest_context"
    },
    {
      "$ref": "#/$defs/envelope_hotel_information"
    },
    {
      "$ref": "#/$defs/envelope_conversation_action"
    },
    {
      "$ref": "#/$defs/envelope_request_draft"
    },
    {
      "$ref": "#/$defs/envelope_request_outcome"
    },
    {
      "$ref": "#/$defs/envelope_reception_transition"
    },
    {
      "$ref": "#/$defs/envelope_guest_status_readback"
    }
  ]
}
