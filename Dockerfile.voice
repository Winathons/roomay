FROM python:3.13.5-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-voice.txt /app/requirements-voice.txt
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
    -r /app/requirements-voice.txt

COPY voice_adapter/ /app/voice_adapter/

EXPOSE 8080

# Railway supplies PORT at runtime; the fallback supports local container smoke tests.
CMD ["sh", "-c", "exec gunicorn voice_adapter.tts_wsgi:application --bind 0.0.0.0:${PORT:-8080} --worker-class gthread --workers 1 --threads 2 --worker-connections 16 --backlog 16 --limit-request-line 4094 --limit-request-fields 64 --limit-request-field_size 4096 --timeout 75 --graceful-timeout 25 --access-logfile - --access-logformat '%(m)s %(U)s %(s)s %(L)s'"]
