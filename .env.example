# Local PostgreSQL only. Replace with a random password and keep .env untracked.
ROOMAY_PG_PASSWORD=replace-with-a-long-random-local-password
ROOMAY_DATABASE_URL=postgresql+psycopg://roomay:replace-with-a-long-random-local-password@127.0.0.1:55432/roomay

# OIDC identifies staff; it does not authorize standalone Workpeg Tables reads.
# Hotel-dependent backend routes remain unavailable until an approved bridge exists.
ROOMAY_WORKPEG_BUSINESS_ID=
ROOMAY_HOTEL_ID=
ROOMAY_BOOTSTRAP_OWNER_ENABLED=false
WORKPEG_OIDC_CLIENT_ID=
WORKPEG_OIDC_CLIENT_SECRET=
ROOMAY_OIDC_REDIRECT_URI=
ROOMAY_PUBLIC_BASE_URL=
ROOMAY_COOKIE_SECURE=true
